# Copy to .env.local for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit .env.local.

# Supabase → Project Settings → Data API: "Project URL"
SUPABASE_URL=
# Supabase → Project Settings → API Keys: a "Secret key" (sb_secret_…), or the legacy service_role key.
# Server-only. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Your private /owner password (at least 8 characters). The public demo password is separate.
OWNER_PASSWORD=
# Random string, at least 32 characters. Signs the /owner login cookie.
OWNER_SESSION_SECRET=
# Random string. Vercel sends it to /api/cron/daily so only Vercel can run the daily job.
CRON_SECRET=
